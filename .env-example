# DOCUMENT_DB=SQLITE

# Session persistence: MEMORY, SQLITE, MONGO/MONGODB, COSMO/COSMOS/COSMOSDB.
SESSION_STORE=SQLITE

# Path to SQLite database file (relative paths resolve from project root)
# Defaults to ignore/session/session.sqlite when unset
SQLITE_PATH=ignore/session/session.sqlite

COSMODB_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnZ0a==
COSMODB_URL=http://localhost:8081/
COSMODB_ID=picoflow
COSMODB_SESSION_ID=sessions
# Set false when deployment tooling already provisioned Cosmos resources.
COSMOS_CREATE_IF_NOT_EXISTS=true
# Leave COSMODB_KEY unset for service-principal or default Azure credentials.
AZURE_TENANT_ID=
COSMO_DB_CLIENT_ID=
COSMO_DB_CLIENT_SECRET=

MONGODB_NAME=picoflow
MONGODB_COLLECTION=sessions
MONGODB_URL=mongodb://localhost:27017/?directConnection=true
# Optional CA bundle for deployments such as AWS DocumentDB; Atlas normally omits it.
MONGODB_TLS_CA_FILE=


{
  "name": "picoflow-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS consumer application and examples for picoflow.",
  "engines": {
    "node": ">=22.5"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:app",
    "clean": "rm -rf ./dist/ ./node_modules/",
    "build:picoflow": "npm --prefix ../picoflow run build:locallib",
    "build:app": "nest build",
    "postbuild": "copyfiles -u 1 'src/**/*.{json,md,png,pdf}' dist/",
    "start": "npm run build && npm run start:prod",
    "start:dev": "nest start --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "mcp:hotel-pricing": "node --import tsx src/tools/hotel-pricing-mcp-server.ts",
    "typecheck": "tsc --project tsconfig.contract.json",
    "test": "npm run test:flows",
    "test:flows": "npm run test:hotel-pricing-mcp && npm run test:basic-flow && npm run test:hotel-flow && npm run test:invoice-flow",
    "test:basic-flow": "node --import tsx --test test/basic-flow/basic-flow.e2e-spec.ts",
    "test:hotel-flow": "node --import tsx --test test/hotel-flow/hotel-flow.e2e-spec.ts",
    "test:hotel-pricing-mcp": "node --import tsx --test test/tools/hotel-pricing-mcp.spec.ts",
    "test:hotel-langgraph": "SESSION_STORE=memory node --import tsx --test test/hotel-langgraph/hotel-langgraph.live.eval.ts",
    "test:invoice-flow": "node --import tsx --test test/invoice-flow/invoice-flow.e2e-spec.ts",
    "test:support-flow": "node --import tsx --test test/support-flow/support-flow.spec.ts"
  },
  "dependencies": {
    "@fastify/static": "9.3.0",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/openai": "1.5.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@picoflow/core": "^1.1.2",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongodb": "6.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/node": "22.20.1",
    "copyfiles": "^2.4.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
